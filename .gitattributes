# Force LF line endings on all files
* text=auto

# Ensure these files always use LF
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.mdc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
