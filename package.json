{
  "name": "ticket-manager-cli",
  "version": "1.0.0",
  "description": "A CLI tool to manage tickets stored locally in JSON files with TDD approach",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "tickets": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": ["cli", "ticket", "manager", "tdd"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "lodash": "^4.17.21",
    "@types/lodash": "^4.14.202"
  }
}
